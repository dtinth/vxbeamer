<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vxbeamer">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Vxbeamer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Catches the sign-in redirect the same way the desktop app's
                 own flow does: the browser lands on vxbeamer's hosted web
                 app, and the operator copies the code shown there back into
                 this app by hand (dtinth/vxbeamer#86). No deep link needed. -->
        </activity>

        <!-- Woken by the system the moment the watch opens a channel, even
             if this app is not running — see RelayListenerService's own
             doc comment for why that means no notification is needed until
             a recording is actually in progress. -->
        <service
            android:name=".RelayListenerService"
            android:exported="true"
            android:foregroundServiceType="dataSync">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
            </intent-filter>
        </service>

        <!-- "Transcribe anywhere" — the phone's own mic, no watch involved.
             supportsPictureInPicture lets this activity shrink into a
             square corner window while a recording is running; see
             PipTranscribeActivity's own doc comment. -->
        <activity
            android:name=".PipTranscribeActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Vxbeamer" />

        <service
            android:name=".PipRecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Toggling from inside any other app, without the "draw over other
             apps" permission banking apps suppress. See ToggleTileService's
             own doc comment for why a tile rather than an overlay or an
             accessibility shortcut. -->
        <service
            android:name=".ToggleTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_mic"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>
</manifest>
